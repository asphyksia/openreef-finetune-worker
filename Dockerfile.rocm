# OpenReef Fine-Tune Worker - AMD ROCm (Axolotl product engine)
#
# ROCm needs a stricter pin than CUDA: gfx variants, ROCm minor versions, and
# bitsandbytes binaries differ across RDNA2/3/4 and pro cards. Strategy:
#   1) Official ROCm+PyTorch base pin (never `:latest`)
#   2) Axolotl pin + ROCm-capable bitsandbytes for clean imports
#   3) Training path stays LoRA + adamw_torch (QLoRA is NVIDIA-only in worker)
#   4) Build-time checks: HIP torch + Axolotl + expected bnb ROCm .so
#
# Unsloth on AMD remains a lab-only experiment. Do not add it to this product
# image until the model/architecture matrix is green on supported AMD targets.

ARG ROCM_PYTORCH_IMAGE=rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0
FROM ${ROCM_PYTORCH_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# The ROCm base uses system Python, so --break-system-packages is required.
COPY requirements-build.txt requirements-worker-io.txt \
    requirements-axolotl-rocm.txt requirements-bitsandbytes-rocm.txt /tmp/
RUN pip install --no-cache-dir --break-system-packages \
    -r /tmp/requirements-build.txt

# Axolotl currently pins a bitsandbytes build which lacks libbitsandbytes_rocm72.so.
# Force 0.49.2 so imports succeed on ROCm 7.2. AMD remains LoRA-only.
RUN pip install --no-cache-dir --break-system-packages \
    -r /tmp/requirements-axolotl-rocm.txt \
    -r /tmp/requirements-worker-io.txt && \
    pip install --no-cache-dir --break-system-packages --no-deps --force-reinstall \
    -r /tmp/requirements-bitsandbytes-rocm.txt

COPY THIRD_PARTY_NOTICES.md /licenses/OPENREEF_THIRD_PARTY_NOTICES.md
COPY scripts/write_dependency_inventory.py /tmp/write_dependency_inventory.py
RUN python /tmp/write_dependency_inventory.py \
    && rm -f /tmp/write_dependency_inventory.py

# Build-time sanity checks (no GPU required on the build host).
RUN python - <<'PY'
import importlib
import pathlib

import torch

hip = getattr(torch.version, "hip", None)
print("torch", torch.__version__, "hip", hip, "cuda", getattr(torch.version, "cuda", None))
if not hip:
    raise SystemExit(
        "FATAL: torch.version.hip is None - this is not a ROCm PyTorch build. "
        "Refuse to publish a CUDA/CPU torch as the AMD worker image."
    )

importlib.import_module("axolotl.cli.train")

bnb_dir = pathlib.Path(importlib.import_module("bitsandbytes").__file__).parent
expected = bnb_dir / "libbitsandbytes_rocm72.so"
if not expected.exists():
    found = sorted(p.name for p in bnb_dir.glob("libbitsandbytes_rocm*.so"))
    raise SystemExit(
        f"Missing expected ROCm 7.2 bitsandbytes binary: {expected.name}. "
        f"Found: {found or 'none'}"
    )
print("runtime sanity OK: ROCm torch + axolotl + bitsandbytes rocm72")
PY

# Job I/O is bind-mounted at /workspace (/data on the provider host).
# Keep application code outside that mount so provider volumes never shadow
# the entrypoint.
WORKDIR /workspace

COPY worker.py runtime_probe.py training_config.py display_gpu_guard.py platform_compat.py pause_guard.py workspace_hygiene.py sft_format.py /app/
ENV PYTHONPATH=/app

ENTRYPOINT ["python", "/app/worker.py"]
